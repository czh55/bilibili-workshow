# Audio source files (large)
*.m4a
*.wav
*.flac
*.webm
*.mp4
*.mkv
*.mp3
# Generated caption speech (needed for GitHub Pages playback)
!docs/audio/
!docs/audio/*.mp3
!docs/audio/**/
!docs/audio/**/*.mp3

# Generated intermediate files
*.srt
*.vtt
*.tsv
*.txt
*.json
!docs/index.json
!docs/topics.json
!meta/*.json
!scripts/scene-data/*.json
# Keep merged caption translation table for incremental updates
!translations.json

# Node modules
node_modules/

# Python cache
__pycache__/
*.pyc

# Local work dirs (frame extraction, previews, grids) — never commit
_work/

# macOS
.DS_Store
